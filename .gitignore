# ===========================================================================
# .gitignore -- cvanders (C port)
# ===========================================================================

# --- Operating system ---
# macOS
.DS_Store
# Windows
Thumbs.db

# --- C / C++ build artifacts ---
# Compiled objects and static libraries
*.o
*.a
*.lo
*.la

# The Makefile build directory (test binaries and the game binary live here)
c/build/

# Coverage / instrumentation
*.gcov
*.gcno
*.gcda

# Tool / sanitizer output that might be redirected to a file
*.log

# --- Editor / IDE scratch ---
*.swp
*.un~
*~
.idea/
.vscode/

# --- Logs ---
*.log

# ---------------------------------------------------------------------------
# Note: the original Python .gitignore had a bare `include/` rule meant for
# Python's generated C-extension headers. That rule was silently ignoring the
# project's own C header (c/include/), so it has been removed. Only C build
# output and OS/editor cruft are ignored now; all source and headers are
# tracked.
# ---------------------------------------------------------------------------
